<%- include('partials/header', { title: heading, preheader: 'Your TechyJaunt code is ' + otp + '. It expires in ' + expiresInMinutes + ' minutes.' }) %>
<p style="margin: 0 0 12px; font-size: 16px; line-height: 1.5; color: #111827;">
  Hi <%= firstName %>,
</p>
<h1 style="margin: 0 0 16px; font-size: 22px; line-height: 1.3; font-weight: 700; color: #111827;">
  <%= heading %>
</h1>
<p style="margin: 0 0 24px; font-size: 15px; line-height: 1.6; color: #374151;">
  Use the code below to <%= purpose %>. It expires in <%= expiresInMinutes %> minutes.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
  <tr>
    <td align="center" style="background-color: #f3f4f6; border-radius: 8px; padding: 18px 12px;">
      <p style="margin: 0; font-size: 32px; letter-spacing: 8px; font-weight: 700; color: #111827;">
        <%= otp %>
      </p>
    </td>
  </tr>
</table>
<p style="margin: 0; font-size: 14px; line-height: 1.6; color: #6b7280;">
  Do not share this code with anyone. TechyJaunt will never ask you for it.
</p>
<%- include('partials/footer') %>
