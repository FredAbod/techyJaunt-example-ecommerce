<%- include('partials/header', { title: 'New sign-in', preheader: 'Someone just signed in to your TechyJaunt account.' }) %>
<p style="margin: 0 0 12px; font-size: 16px; line-height: 1.5; color: #111827;">
  Hi <%= firstName %>,
</p>
<h1 style="margin: 0 0 16px; font-size: 22px; line-height: 1.3; font-weight: 700; color: #111827;">
  New sign-in to your account
</h1>
<p style="margin: 0 0 20px; font-size: 15px; line-height: 1.6; color: #374151;">
  We noticed a sign-in to the TechyJaunt account for <strong><%= email %></strong>.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 20px; background-color: #f9fafb; border-radius: 8px;">
  <tr>
    <td style="padding: 16px 18px;">
      <p style="margin: 0 0 4px; font-size: 12px; letter-spacing: 0.4px; text-transform: uppercase; color: #6b7280;">
        Time
      </p>
      <p style="margin: 0; font-size: 15px; color: #111827;">
        <%= loginTime %>
      </p>
    </td>
  </tr>
</table>
<p style="margin: 0; font-size: 15px; line-height: 1.6; color: #374151;">
  If this was you, no action is needed. If you do not recognize this sign-in, reset your password right away.
</p>
<%- include('partials/footer') %>
